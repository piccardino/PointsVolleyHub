<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="4dp"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants">

    <TextView
        android:id="@+id/timerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/recentPointsRow"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:layout_marginTop="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timerView" />

    <TextView
        android:id="@+id/setsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set: 0 - 0"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/recentPointsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/teamASection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/setsView"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSwapSides"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/scoreAView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/team_a_color"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnSwapSides"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_swap_horiz"
        android:background="@drawable/button_swap_flat"
        android:contentDescription="Swap sides"
        android:scaleType="fitCenter"
        android:padding="5dp"
        app:tint="#FFFFFF"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="@id/teamASection"
        app:layout_constraintBottom_toBottomOf="@id/teamASection"
        app:layout_constraintStart_toEndOf="@id/teamASection"
        app:layout_constraintEnd_toStartOf="@id/teamBSection" />

    <LinearLayout
        android:id="@+id/teamBSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:layout_marginTop="0dp"
        android:layout_marginStart="1dp"
        android:paddingTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/setsView"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toEndOf="@id/btnSwapSides"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/scoreBView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/team_b_color"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/controlButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <Button
                android:id="@+id/btnAddPointA"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="+ A"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:background="@drawable/button_team_a_flat"
                android:padding="2dp"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnRemovePointA"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="- A"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:background="@drawable/button_secondary_flat"
                android:padding="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="4dp">

            <Button
                android:id="@+id/btnAddPointB"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="+ B"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:background="@drawable/button_team_b_flat"
                android:padding="2dp"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnRemovePointB"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="- B"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:background="@drawable/button_secondary_flat"
                android:padding="2dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="28dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnToggleTimer"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="START"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_start_flat"
            app:backgroundTint="#1c1c1c"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnResetMatch"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="RESET"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_reset_flat"
            app:backgroundTint="#1c1c1c"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="EXIT"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_logout_flat"
            app:backgroundTint="#1c1c1c"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/digitalClockView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="@color/text_secondary"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/playersPage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Giocatori"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playersSwipeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Swipe &lt;- per tornare"
            android:textColor="@color/text_secondary"
            android:textSize="8sp" />

        <Button
            android:id="@+id/btnGenerateTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERA SQUADRE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/playersListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/btnCheckUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text="AGGIORNAMENTO OTA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_secondary_flat"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/appVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PointsVolleyHub v1.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
