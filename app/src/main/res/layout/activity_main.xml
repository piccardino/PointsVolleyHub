<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="8dp">

    <!-- Timer Display -->
    <TextView
        android:id="@+id/timerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sets Display -->
    <TextView
        android:id="@+id/setsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set: 0 - 0"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/timerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Team A Section -->
    <LinearLayout
        android:id="@+id/teamASection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintTop_toBottomOf="@id/setsView"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/teamBSection"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/teamANameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team A"
            android:textColor="@color/team_a_color"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreAView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/team_a_color"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Team B Section -->
    <LinearLayout
        android:id="@+id/teamBSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginStart="2dp"
        app:layout_constraintTop_toBottomOf="@id/setsView"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toEndOf="@id/teamASection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/teamBNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team B"
            android:textColor="@color/team_b_color"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreBView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/team_b_color"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Button Row -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/controlButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Team A Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <Button
                android:id="@+id/btnAddPointA"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="+ A"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:background="@drawable/button_team_a_flat"
                android:padding="2dp"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnRemovePointA"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="- A"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:background="@drawable/button_secondary_flat"
                android:padding="2dp" />

        </LinearLayout>

        <!-- Team B Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="4dp">

            <Button
                android:id="@+id/btnAddPointB"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="+ B"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:background="@drawable/button_team_b_flat"
                android:padding="2dp"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnRemovePointB"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="- B"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:background="@drawable/button_secondary_flat"
                android:padding="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnToggleTimer"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="START"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_start_flat"
            android:backgroundTint="#333333"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnResetMatch"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="RESET"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_reset_flat"
            android:backgroundTint="#333333"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="EXIT"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/button_logout_flat"
            android:backgroundTint="#333333"
            android:padding="2dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
